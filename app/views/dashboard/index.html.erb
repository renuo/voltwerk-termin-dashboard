<h1 class="text-5xl pt-[2.5vh] pb-[2.5vh] pl-6 bg-blue-300">The Dashboard</h1>

<div class="pl-8 h-full">
  <div class="flex flex-row">
    <div class="min-w-1/12 mr-5">
      <div class="border-2 rounded-b-md rounded-t-md p-0.5 hover:bg-gray-300 text-center">
        <%= link_to "your calendar", user_path(Current.user.id) %>
      </div>
      <div class="border-2 rounded-b-md rounded-t-md p-0.5 hover:bg-gray-300 text-center mt-1.5">
        <% if authenticated? %>
          <%= button_to "Sign Out", session_path, method: :delete  %>
        <% else %>
          <%= link_to "Sign In", new_session_path %>
        <% end %>
      </div>
    </div>
    <div class=" calendar-box mr-20 border-2 rounded-b-md rounded-t-md w-full h-[80vh]"></div>
  </div>
</div>

