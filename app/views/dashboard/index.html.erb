<h1 class="text-5xl pt-[2.5vh] pb-[2.5vh] pl-6 bg-blue-300">The Dashboard</h1>

<div class="md:pl-8 h-full">
  <div class="flex flex-row">
    <div class="min-w-1/12 mr-5">
      <div class="border-2 rounded-b-md rounded-t-md p-0.5 hover:bg-gray-300 text-center">
        <%= link_to "your calendar", user_path(Current.user.id) %>
      </div>
    </div>
    <div id="calendar" class="absolute md:calendar-box calendar-box-small md:mr-20 md:ml-40 max-sm:ml-1 max-sm:mt-10 border-2 rounded-b-md rounded-t-md w-[98vw] md:w-[85vw] h-[80vh] overflow-scroll ">
      <% counter = 0 %>
      <% 108.times do %>
        <% if counter % 6 == 0 %>
          <% if counter == 0 %>
            <div class="blank_slot text-center pt-6 text-sm top-border"><%= "#{(counter/6)+5}:00 Uhr" %></div>
          <% else %>
            <div class="blank_slot text-center pt-6 text-sm"><%= "#{(counter/6)+5}:00 Uhr" %></div>
          <% end %>
        <% else %>
          <% if counter <= 5 %>
            <div class="blank_slot top-border"></div>
          <% else %>
            <div class="blank_slot"></div>
          <% end %>
        <% end %>
        <% counter += 1 %>
      <% end %>
      <div class="time_slot top-[50%] left-[28%] time_slot-4 blank_slot bg-amber-200 overflow-scroll"></div>
    </div>
  </div>
</div>
